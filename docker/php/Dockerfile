FROM php:8.4-fpm

# Install system dependencies
RUN apt-get update && apt-get install -y \
    git curl libpng-dev libonig-dev libxml2-dev \
    zip unzip mariadb-client nginx supervisor \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# Install PHP extensions (including opentelemetry required by ProcessMaker)
ADD https://github.com/mlocati/docker-php-extension-installer/releases/latest/download/install-php-extensions /usr/local/bin/
RUN chmod +x /usr/local/bin/install-php-extensions && \
    install-php-extensions gd imagick imap pdo_mysql zip bcmath redis sockets pcntl opentelemetry

# Install Node.js 20 (for npm run dev)
RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y nodejs && apt-get clean

# Install Composer
COPY --from=composer:latest /usr/bin/composer /usr/bin/composer

# Copy application source
WORKDIR /var/www/html
COPY . /var/www/html

# Permissions
RUN chown -R www-data:www-data /var/www/html \
    && chmod -R 775 /var/www/html/storage /var/www/html/bootstrap/cache || true

# Install PHP dependencies
# Create minimal stub .env so artisan package:discover doesn't fail at build time
# The real .env is generated by entrypoint.sh at runtime
ENV COMPOSER_ALLOW_SUPERUSER=1
RUN printf 'APP_NAME=ProcessMaker\nAPP_ENV=production\nAPP_KEY=\nAPP_DEBUG=false\nAPP_URL=http://localhost\nDB_HOST=localhost\nDB_DATABASE=processmaker\nDB_USERNAME=root\nDB_PASSWORD=\nREDIS_HOST=localhost\n' > .env \
    && composer install --no-interaction --optimize-autoloader --ignore-platform-reqs \
    && rm .env

# Build frontend assets
RUN npm install && npm run dev || true

# Nginx configuration
COPY docker/nginx/default.conf /etc/nginx/conf.d/default.conf
# Disable the default nginx site
RUN rm -f /etc/nginx/sites-enabled/default

# Supervisor log dir
RUN mkdir -p /var/log/supervisor

# Copy supervisor and entrypoint
COPY docker/php/supervisord.conf /etc/supervisor/conf.d/supervisord.conf
COPY docker/php/entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

EXPOSE 80 8080

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
