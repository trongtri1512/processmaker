# ============================================================
# ProcessMaker Docker Environment Configuration
# Sao chép file này thành .env và điền thông tin của bạn
# ============================================================

# URL công khai của ứng dụng (KHÔNG có dấu / ở cuối)
# Ví dụ Dokploy: https://your-domain.traefik.me
APP_URL=https://your-domain.traefik.me

# Tài khoản Admin lần đầu cài đặt (chỉ áp dụng khi chưa cài)
PM_ADMIN_USERNAME=admin
PM_ADMIN_PASSWORD=processmaker2024!
PM_ADMIN_EMAIL=admin@processmaker.local
PM_ADMIN_FIRST_NAME=Admin
PM_ADMIN_LAST_NAME=User
